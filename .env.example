# Copie para backend/.env e preencha. NUNCA versione o .env real.
# Apenas nomes — sem valores reais.

# --- Banco de dados ---
MONGO_URL=
DB_NAME=
CORS_ORIGINS=

# --- Aplicação ---
APP_URL=
COOKIE_SECURE=

# --- Mercado Pago (PIX) — SOMENTE BACKEND, nunca prefixar com NEXT_PUBLIC_ ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_ENVIRONMENT=

# --- WhatsApp Business (Meta Cloud API) — SOMENTE BACKEND ---
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Firebase (quando portado para Next.js/Firebase) ---
# Públicas (expostas ao navegador — sem segredos aqui)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Privadas (Firebase Admin SDK — somente server-side)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Sessão ---
JWT_SECRET=
